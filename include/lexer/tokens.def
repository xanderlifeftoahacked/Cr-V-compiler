#ifndef TOK
#define TOK(t)
#endif

#ifndef PUNCT
#define PUNCT(t, s) TOK(t)
#endif

#ifndef KEYWORD
#define KEYWORD(t) TOK(KW_##t)
#endif

TOK(UNKNOWN)
TOK(EOF)
TOK(IDENTIFIER)
TOK(NUMBER)
TOK(CHAR_LITERAL)
TOK(STRING_LITERAL)

PUNCT(LSHIFT_ASSIGN,  "<<=")
PUNCT(RSHIFT_ASSIGN,  ">>=")
PUNCT(LSHIFT,         "<<")
PUNCT(RSHIFT,         ">>")
PUNCT(LESS_EQUAL,     "<=")
PUNCT(GREATER_EQUAL,  ">=")
PUNCT(EQUAL,          "==")
PUNCT(NOT_EQUAL,      "!=")
PUNCT(LOGICAL_AND,    "&&")
PUNCT(LOGICAL_OR,     "||")
PUNCT(PLUS_PLUS,      "++")
PUNCT(MINUS_MINUS,    "--")
PUNCT(PLUS_ASSIGN,    "+=")
PUNCT(MINUS_ASSIGN,   "-=")
PUNCT(STAR_ASSIGN,    "*=")
PUNCT(DIV_ASSIGN,     "/=")
PUNCT(MOD_ASSIGN,     "%=")
PUNCT(AMPERSAND_ASSIGN, "&=")
PUNCT(PIPE_ASSIGN,    "|=")
PUNCT(CARET_ASSIGN,   "^=")

PUNCT(LPAREN,         "(")
PUNCT(RPAREN,         ")")
PUNCT(LBRACE,         "{")
PUNCT(RBRACE,         "}")
PUNCT(LBRACKET,       "[")
PUNCT(RBRACKET,       "]")
PUNCT(SEMICOLON,      ";")
PUNCT(COMMA,          ",")
PUNCT(COLON,          ":")
PUNCT(PLUS,           "+")
PUNCT(MINUS,          "-")
PUNCT(STAR,           "*")
PUNCT(DIV,            "/")
PUNCT(MOD,            "%")
PUNCT(LESS,           "<")
PUNCT(GREATER,        ">")
PUNCT(ASSIGN,         "=")
PUNCT(AMPERSAND,      "&")
PUNCT(PIPE,           "|")
PUNCT(CARET,          "^")
PUNCT(TILDE,          "~")
PUNCT(EXCLAIM,        "!")

KEYWORD(int)
KEYWORD(char)
KEYWORD(static)
KEYWORD(extern)
KEYWORD(if)
KEYWORD(else)
KEYWORD(while)
KEYWORD(for)
KEYWORD(do)
KEYWORD(switch)
KEYWORD(case)
KEYWORD(default)
KEYWORD(break)
KEYWORD(continue)
KEYWORD(return)
KEYWORD(goto)

#undef TOK
#undef PUNCT
#undef KEYWORD
